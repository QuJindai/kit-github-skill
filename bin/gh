#!/usr/bin/env python3
"""Minimal GitHub API CLI using the stored custom.github credential.

Usage:
    gh GET /user
    gh GET /repos/OWNER/REPO/issues --params '{"state":"open","per_page":20}'
    gh POST /repos/OWNER/REPO/issues --json '{"title":"...","body":"..."}'
    gh PATCH /repos/OWNER/REPO/issues/1 --json '{"state":"closed"}'
"""
import json
import sys
import urllib.parse
import urllib.request

sys.path.insert(0, "/opt/hatch/skills/skill-creator/bin")
from dynamic_credentials import (  # noqa: E402
    add_surrogate_to_request,
    read_json_response,
)

API = "https://api.github.com"
ALLOWED = ("api.github.com",)


def main() -> int:
    args = sys.argv[1:]
    if len(args) < 2 or args[0] not in ("GET", "POST", "PATCH", "PUT", "DELETE"):
        print(__doc__.strip(), file=sys.stderr)
        return 2
    method, path = args[0], args[1]
    params = None
    data = None
    i = 2
    while i < len(args):
        if args[i] == "--params":
            params = json.loads(args[i + 1])
            i += 2
        elif args[i] == "--json":
            data = json.dumps(json.loads(args[i + 1])).encode()
            i += 2
        else:
            print(f"unknown arg: {args[i]}", file=sys.stderr)
            return 2

    url = API + path
    if params:
        url += "?" + urllib.parse.urlencode(params, doseq=True)
    req = urllib.request.Request(url, data=data, method=method)
    req.add_header("Accept", "application/vnd.github+json")
    req.add_header("X-GitHub-Api-Version", "2022-11-28")
    req.add_header("User-Agent", "kit-assistant")
    if data is not None:
        req.add_header("Content-Type", "application/json")
    add_surrogate_to_request(
        req, "custom.github", entry_name="access_token", allowed_hosts=ALLOWED
    )
    try:
        with urllib.request.urlopen(req, timeout=30) as resp:
            body = read_json_response(resp)
    except urllib.error.HTTPError as e:
        try:
            err = e.read().decode()[:500]
        except Exception:
            err = ""
        print(f"HTTP {e.code}: {err}", file=sys.stderr)
        return 1
    print(json.dumps(body, ensure_ascii=False, indent=2))
    return 0


if __name__ == "__main__":
    sys.exit(main())
